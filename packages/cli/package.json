{
  "name": "@applification/contexture",
  "version": "0.15.52",
  "private": true,
  "description": "Command-line schema editing tools for Contexture projects.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
